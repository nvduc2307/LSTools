<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:ui="clr-namespace:LSTool.Utils.UI">
    <!-- Scope Fluent resources to each tool window; Revit owns Application.Current. -->
    <ResourceDictionary.MergedDictionaries>
        <fluent:ThemesDictionary Theme="Light"/>
        <fluent:ControlsDictionary/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Ink" Color="#172033"/>
    <SolidColorBrush x:Key="Line" Color="#D7DEE8"/>
    <SolidColorBrush x:Key="HeaderSurface" Color="#F1F4F8"/>
    <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentButtonForeground" Color="White"/>
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White"/>
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#2563EB"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2563EB"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#2563EB"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#2563EB"/>
    <sys:Double x:Key="ControlContentThemeFontSize">13</sys:Double>
    <sys:Double x:Key="TextControlThemeMinHeight">24</sys:Double>
    <sys:Double x:Key="TextControlThemeMinWidth">0</sys:Double>
    <Thickness x:Key="TextControlThemePadding">6,2</Thickness>
    <Thickness x:Key="ComboBoxPadding">6,2,28,2</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>

    <x:Static x:Key="MainBarHookDiagram" Member="ui:ReferenceDrawings.MainBarHook"/>
    <x:Static x:Key="StirrupHookDiagram" Member="ui:ReferenceDrawings.StirrupHook"/>
    <Style x:Key="ToolWindow" TargetType="Window">
        <Setter Property="Icon" Value="{x:Static ui:ReferenceDrawings.AppIcon}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="SizeToContent" Value="Manual"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ui:WindowLayout.Enabled" Value="True"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Keep library templates; only density, colours and interaction states differ. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style TargetType="fluent:TextBox" BasedOn="{StaticResource DefaultUiTextBoxStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="ClearButtonEnabled" Value="False"/>
    </Style>
    <Style x:Key="CellInput" TargetType="fluent:TextBox" BasedOn="{StaticResource {x:Type fluent:TextBox}}">
        <Setter Property="Margin" Value="3,1"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="6,2,28,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style TargetType="fluent:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="#BBC5D3"/>
        <Setter Property="MouseOverBackground" Value="#F1F5F9"/>
        <Setter Property="MouseOverBorderBrush" Value="{StaticResource Blue}"/>
        <Setter Property="PressedBackground" Value="#F1F5F9"/>
        <Setter Property="PressedForeground" Value="{StaticResource Ink}"/>
        <Setter Property="PressedBorderBrush" Value="{StaticResource Blue}"/>
        <!-- No extra focus frame or geometry/opacity changes on mouse press. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DialogButton" TargetType="fluent:Button" BasedOn="{StaticResource {x:Type fluent:Button}}">
        <Setter Property="Width" Value="80"/>
        <Setter Property="MinWidth" Value="80"/>
    </Style>
    <Style x:Key="CancelButton" TargetType="fluent:Button" BasedOn="{StaticResource DialogButton}">
        <Setter Property="IsCancel" Value="True"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="fluent:Button" BasedOn="{StaticResource DialogButton}">
        <Setter Property="Appearance" Value="Primary"/>
        <Setter Property="Background" Value="{StaticResource Blue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="MouseOverBackground" Value="{StaticResource Blue}"/>
        <Setter Property="PressedBackground" Value="{StaticResource Blue}"/>
        <Setter Property="PressedForeground" Value="White"/>
    </Style>

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="White"/>
    </Style>
    <Style x:Key="PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HeaderSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="5,5,0,0"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style x:Key="CompactGridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultUiDataGridColumnHeaderStyle}">
        <Setter Property="Background" Value="{StaticResource HeaderSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="6,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CompactGridCell" TargetType="DataGridCell" BasedOn="{StaticResource DefaultUiDataGridCellStyle}">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#DBEAFE"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CompactGridRow" TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style TargetType="fluent:DataGrid" BasedOn="{StaticResource DefaultUiDataGridStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E5EAF0"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="CellStyle" Value="{StaticResource CompactGridCell}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CompactGridHeader}"/>
        <Setter Property="RowStyle" Value="{StaticResource CompactGridRow}"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="False"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>
</ResourceDictionary>
