<UserControl
    x:Class="LSTool.Tools.Beams.InstallRebarBeamV2.views.SettingSubSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:LSTool.Tools.Beams.InstallRebarBeamV2.views"
    xmlns:behaviors="clr-namespace:LSTool.Tools.Beams.InstallRebarBeamV2.Support.Wpf"
    xmlns:langs ="clr-namespace:LSTool.Properties.Langs"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="990">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        
        <!--<Style TargetType="ComboBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>-->
        <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="4">
                            <Path x:Name="arrow"
                            Data="M 0 0 L 4 4 L 8 0"
                            Stroke="#4A90D9"
                            StrokeThickness="1.5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A90D9"/>
                                <Setter TargetName="border" Property="Background" Value="#F7FBFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A90D9"/>
                                <Setter TargetName="border" Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B8D4EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1A5276"/>
            <Setter Property="Padding" Value="8,0,28,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                    Style="{StaticResource ComboBoxToggleButton}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                Content="{TemplateBinding SelectedItem}"
                                ContentTemplate="{TemplateBinding ItemTemplate}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                             Placement="Bottom"
                             IsOpen="{TemplateBinding IsDropDownOpen}"
                             AllowsTransparency="True"
                             Focusable="False"
                             PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                  Background="White"
                                  BorderBrush="#B8D4EE"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  Margin="0,2,0,0"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#6B8FA8" ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#1A5276"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                          Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EBF4FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6EAF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#C9D8D3"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="#24414A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Label nhỏ phía trên control -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7C8D"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

    </UserControl.Resources>
    <Grid Background="#FAFCFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F1F7F5" BorderBrush="#C9D8D3" BorderThickness="1"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Additional Bars" Foreground="#185B4A" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="Configure erection bars and secondary reinforcement shared by the beam assembly."
                           Foreground="#718A84" FontSize="10" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#C9D8D3" BorderThickness="1"
                    CornerRadius="6" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Erection Bars" Foreground="#24414A" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="Bars used to stabilize and assemble the reinforcement cage."
                               Foreground="#718A84" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_REBAR_DIAMETER}"/>
                            <ComboBox ItemsSource="{Binding ElementInstances.RebarDiameters}"
                                      SelectedItem="{Binding ElementInstances.RebarBeamDantory.Diameter}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_REBAR_QUANTITY}"/>
                            <TextBox Text="{Binding ElementInstances.RebarBeamDantory.Quantity}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#17252E" CornerRadius="6" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Assembly-wide setting" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="This configuration is applied across all physical spans. You do not need to repeat it for each span."
                               Foreground="#B8C8C4" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Border Height="3" Width="56" Background="#21C99A" CornerRadius="2"
                            HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>


