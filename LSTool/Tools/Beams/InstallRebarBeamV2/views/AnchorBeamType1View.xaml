<UserControl x:Class="LSTool.Tools.Beams.InstallRebarBeamV2.views.AnchorBeamType1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LSTool.Tools.Beams.InstallRebarBeamV2.views"
             xmlns:behaviors="clr-namespace:LSTool.Tools.Beams.InstallRebarBeamV2.Support.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Canvas Height="220" Width="520">
            <StackPanel Orientation="Horizontal">
                <Image Width="260" Source="../imgs/AnchorStart-Type1.png"/>
                <Image Width="260" Source="../imgs/AnchorEnd-Type1.png"/>
            </StackPanel>
            <StackPanel 
                Canvas.Top="5" 
                Canvas.Left="40" 
                Orientation="Horizontal">
                <TextBox 
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                    Text="{Binding ElementInstances.RebarBeamAnchor.Type1_L1_X_Start}"/>
                <TextBlock Text="mm"/>
            </StackPanel>
            <StackPanel 
                Canvas.Top="80" 
                Canvas.Left="5" 
                Orientation="Vertical">
                <TextBox
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                    Text="{Binding ElementInstances.RebarBeamAnchor.Type1_L1_Y_Start}"/>
                <TextBlock Text="mm"/>
            </StackPanel>
            <StackPanel 
                Canvas.Top="92" 
                Canvas.Left="120" 
                Orientation="Horizontal">
                <TextBox 
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                    Text="{Binding ElementInstances.RebarBeamAnchor.Type1_L3_Y_Start}"/>
                <TextBlock Text="mm"/>
            </StackPanel>
            <StackPanel 
                Canvas.Top="155" 
                Canvas.Left="54" 
                Orientation="Horizontal">
                <TextBox 
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                    Text="{Binding ElementInstances.RebarBeamAnchor.Type1_L3_X_Start}"/>
                <TextBlock Text="mm"/>
            </StackPanel>

            <StackPanel 
                Canvas.Top="5" 
                Canvas.Left="450" 
                Orientation="Horizontal">
                <TextBox Text="{Binding ElementInstances.RebarBeamAnchor.Type1_L1_X_End}"/>
                <TextBlock Text="mm"/>
            </StackPanel>
            <StackPanel 
                Canvas.Top="80" 
                Canvas.Left="485" 
                Orientation="Vertical">
                <TextBox 
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                    Text="{Binding ElementInstances.RebarBeamAnchor.Type1_L1_Y_End}"/>
                <TextBlock Text="mm"/>
            </StackPanel>
            <StackPanel 
                Canvas.Top="92" 
                Canvas.Left="346" 
                Orientation="Horizontal">
                <TextBlock Text="mm"/>
                <TextBox 
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                    Text="{Binding ElementInstances.RebarBeamAnchor.Type1_L3_Y_End}"/>
            </StackPanel>
            <StackPanel 
                Canvas.Top="155" 
                Canvas.Left="413" 
                Orientation="Horizontal">
                <TextBlock Text="mm"/>
                <TextBox 
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                    Text="{Binding ElementInstances.RebarBeamAnchor.Type1_L3_X_End}"/>
            </StackPanel>
        </Canvas>
    </StackPanel>
</UserControl>


