<Window x:Class="LSTool.Tools.Beams.InstallRebarBeamV2.views.InstallRebarBeamView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LSTool.Tools.Beams.InstallRebarBeamV2.views"
        xmlns:userControl ="clr-namespace:LSTool.Tools.Beams.InstallRebarBeamV2.views"
        xmlns:langs ="clr-namespace:LSTool.Properties.Langs"
        mc:Ignorable="d"
        Title="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_COMMAND_NAME}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        MinHeight="700"
        MinWidth="990">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="ButtonPrimary" TargetType="Button">
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinWidth" Value="80"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="#4A90D9"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="#3A7BC8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3A7BC8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#2B6CB0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ButtonSecondary" TargetType="Button">
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinWidth" Value="70"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#4A90D9"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="#B8D4EE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EBF4FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#D6EAF8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tab button style: bottom-border indicator khi selected -->
            <Style x:Key="TabRadio" TargetType="RadioButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <TextBlock Padding="16,0"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Text="{TemplateBinding Content}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#6B8FA8"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="BorderThickness" Value="0,0,0,3"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F0F7FF"/>
                        <Setter Property="Foreground" Value="#4A90D9"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="#4A90D9"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#4A90D9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--<Style TargetType="ComboBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>-->
            <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="ClickMode" Value="Press"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="border"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="4">
                                <Path x:Name="arrow"
                            Data="M 0 0 L 4 4 L 8 0"
                            Stroke="#4A90D9"
                            StrokeThickness="1.5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            IsHitTestVisible="False"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#4A90D9"/>
                                    <Setter TargetName="border" Property="Background" Value="#F7FBFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#4A90D9"/>
                                    <Setter TargetName="border" Property="Background" Value="#F0F7FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#B8D4EE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#1A5276"/>
                <Setter Property="Padding" Value="8,0,28,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                    Style="{StaticResource ComboBoxToggleButton}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter x:Name="ContentSite"
                                Content="{TemplateBinding SelectedItem}"
                                ContentTemplate="{TemplateBinding ItemTemplate}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup"
                             Placement="Bottom"
                             IsOpen="{TemplateBinding IsDropDownOpen}"
                             AllowsTransparency="True"
                             Focusable="False"
                             PopupAnimation="Slide">
                                    <Border x:Name="DropDownBorder"
                                  Background="White"
                                  BorderBrush="#B8D4EE"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  Margin="0,2,0,0"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#6B8FA8" ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
                                        </Border.Effect>
                                        <ScrollViewer>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="#1A5276"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border Background="{TemplateBinding Background}"
                          Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EBF4FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#D6EAF8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Height" Value="28"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="TitleBarButton" TargetType="Button">
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TitleButtonBorder" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TitleButtonBorder" Property="Background" Value="#D64545"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="TitleButtonBorder" Property="Background" Value="#B83232"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="White" BorderBrush="#B8D4EE" BorderThickness="1">
        <StackPanel>

            <Border Height="32"
                    Background="#1A5276"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource TitleBarButton}"
                            Click="CloseButton_Click"
                            Content="×"
                            ToolTip="Close"/>
                    <TextBlock Margin="10,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </DockPanel>
            </Border>

            <!-- Toolbar: type selector + CRUD actions -->
            <Border Background="#F7FBFF"
                    BorderBrush="#B8D4EE"
                    BorderThickness="0,0,0,1"
                    Padding="12,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding ElementInstances.RebarBeamTypes}"
                                  SelectedItem="{Binding ElementInstances.RebarBeamTypeSelected}"
                                  Width="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NameType}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Style="{StaticResource ButtonSecondary}"
                                Command="{Binding ApplyCommand}"
                                Margin="8,0,0,0"
                                Content="Apply to Current"
                                ToolTip="Apply the selected preset to the current span only"/>
                        <Button Style="{StaticResource ButtonSecondary}"
                                Command="{Binding SaveCommand}"
                                Margin="5,0,0,0"
                                Content="Save"/>
                        <Button Style="{StaticResource ButtonSecondary}"
                                Command="{Binding DeleteCommand}"
                                Margin="5,0,0,0"
                                Content="Delete"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBox Text="{Binding ElementInstances.RebarBeamTypeName}"
                                 Width="140"
                                 Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ButtonSecondary}"
                                Width="Auto"
                                Command="{Binding SaveAsCommand}">
                            <TextBlock Text="Save As" Padding="10,0"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Horizontal tab strip -->
            <Border BorderBrush="#B8D4EE" BorderThickness="0,0,0,1" Background="White">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabRadio}"
                                 Command="{Binding TabSettingRebarSectionViewCommand}"
                                 GroupName="menuTab"
                                 IsChecked="True"
                                 Content="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_TAB_SETTING_SECTION}"
                                 Checked="RadioButton_Checked"/>
                    <RadioButton Style="{StaticResource TabRadio}"
                                 Command="{Binding TabSettingStirrupRebarSectionViewCommand}"
                                 GroupName="menuTab"
                                 Content="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_TAB_SETTING_STIRRUP_TYPE}"/>
                    <RadioButton Style="{StaticResource TabRadio}"
                                 Command="{Binding TabSettingBeamViewCommand}"
                                 GroupName="menuTab"
                                 Content="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_TAB_SETTING_BEAM}"/>
                    <RadioButton Style="{StaticResource TabRadio}"
                                 Command="{Binding TabSettingSubSettingViewCommand}"
                                 GroupName="menuTab"
                                 Content="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_TAB_SETTING_SUB_SETTING}"/>
                </StackPanel>
            </Border>

            <!-- Content area -->
            <UserControl Content="{Binding UserControlViewCurrent}" Margin="10,10,10,0"/>

            <Separator Margin="12,8,12,0" Background="#D6EAF8"/>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="12,8,12,12">
                <Button Style="{StaticResource ButtonPrimary}"
                        Command="{Binding OKCommand}"
                        Content="OK"/>
                <Button Style="{StaticResource ButtonSecondary}"
                        Command="{Binding CancelCommand}"
                        Margin="8,0,0,0"
                        Content="Cancel"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>


