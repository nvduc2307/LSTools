<Window x:Class="LSTool.Tools.Beams.InstallRebarBeamV2.views.InstallRebarBeamView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LSTool.Tools.Beams.InstallRebarBeamV2.views"
        xmlns:userControl ="clr-namespace:LSTool.Tools.Beams.InstallRebarBeamV2.views"
        xmlns:langs ="clr-namespace:LSTool.Properties.Langs"
        mc:Ignorable="d"
        Title="rebar beam"
        Width="1280"
        Height="840"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        MinHeight="760"
        MinWidth="1280"
        Background="#F2F5F4"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="ButtonPrimary" TargetType="Button">
                <Setter Property="Height" Value="36"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="#11A37F"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="#0D8B6D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0D8B6D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#08745A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ButtonSecondary" TargetType="Button">
                <Setter Property="Height" Value="36"/>
                <Setter Property="MinWidth" Value="80"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#24414A"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="#C6D5D0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E7F6F1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#D5ECE5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tab button style: bottom-border indicator khi selected -->
            <Style x:Key="TabRadio" TargetType="RadioButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <TextBlock Padding="16,0"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Text="{TemplateBinding Content}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#6B8FA8"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="BorderThickness" Value="0,0,0,3"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F0F7FF"/>
                        <Setter Property="Foreground" Value="#4A90D9"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="#4A90D9"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#4A90D9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--<Style TargetType="ComboBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>-->
            <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="ClickMode" Value="Press"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="border"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="4">
                                <Path x:Name="arrow"
                            Data="M 0 0 L 4 4 L 8 0"
                            Stroke="#4A90D9"
                            StrokeThickness="1.5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            IsHitTestVisible="False"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#4A90D9"/>
                                    <Setter TargetName="border" Property="Background" Value="#F7FBFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#4A90D9"/>
                                    <Setter TargetName="border" Property="Background" Value="#F0F7FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#B8D4EE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#1A5276"/>
                <Setter Property="Padding" Value="8,0,28,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                    Style="{StaticResource ComboBoxToggleButton}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter x:Name="ContentSite"
                                Content="{TemplateBinding SelectedItem}"
                                ContentTemplate="{TemplateBinding ItemTemplate}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup"
                             Placement="Bottom"
                             IsOpen="{TemplateBinding IsDropDownOpen}"
                             AllowsTransparency="True"
                             Focusable="False"
                             PopupAnimation="Slide">
                                    <Border x:Name="DropDownBorder"
                                  Background="White"
                                  BorderBrush="#B8D4EE"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  Margin="0,2,0,0"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#6B8FA8" ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
                                        </Border.Effect>
                                        <ScrollViewer>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="#1A5276"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border Background="{TemplateBinding Background}"
                          Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EBF4FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#D6EAF8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Height" Value="30"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="TitleBarButton" TargetType="Button">
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TitleButtonBorder" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TitleButtonBorder" Property="Background" Value="#D64545"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="TitleButtonBorder" Property="Background" Value="#B83232"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavRadio" TargetType="RadioButton">
                <Setter Property="Height" Value="46"/>
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="#B8C8C4"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="NavItem"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="3,0,0,0"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavItem" Property="Background" Value="#24343E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="NavItem" Property="Background" Value="#183C35"/>
                                    <Setter TargetName="NavItem" Property="BorderBrush" Value="#21C99A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SidebarCaption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#718A84"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="2,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="#F2F5F4" BorderBrush="#20313A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#14242C"
                    BorderBrush="#11A37F"
                    BorderThickness="0,0,0,2"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="4" Height="26" CornerRadius="2"
                            Background="#21C99A" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Foreground="White" FontSize="15" FontWeight="SemiBold"
                                   Text="Beam Reinforcement"/>
                        <TextBlock Foreground="#9CB0AA" FontSize="10"
                                   Text="Multi-span configuration workspace"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource TitleBarButton}"
                            Click="CloseButton_Click"
                            Content="&#x00D7;"
                            ToolTip="Close"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#17252E" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource SidebarCaption}" Text="PRESET LIBRARY"/>
                            <ComboBox ItemsSource="{Binding ElementInstances.RebarBeamTypes}"
                                      SelectedItem="{Binding ElementInstances.RebarBeamTypeSelected}"
                                      Width="172">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NameType}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Style="{StaticResource ButtonSecondary}"
                                    Command="{Binding ApplyCommand}"
                                    Margin="0,8,0,0"
                                    Content="Apply to Current Span"
                                    ToolTip="Apply the selected preset to the current span only"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource ButtonSecondary}"
                                        Command="{Binding SaveCommand}" Margin="0,0,4,0" Content="Save"/>
                                <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}"
                                        Command="{Binding DeleteCommand}" Margin="4,0,0,0" Content="Delete"/>
                            </Grid>
                            <TextBox Text="{Binding ElementInstances.RebarBeamTypeName}"
                                     Margin="0,8" Height="30" VerticalContentAlignment="Center"/>
                            <Button Style="{StaticResource ButtonSecondary}"
                                    Command="{Binding SaveAsCommand}" Content="Save as New Preset"/>
                        </StackPanel>

                        <Border Grid.Row="1" Height="1" Background="#2D414A" Margin="0,16"/>

                        <StackPanel Grid.Row="2">
                            <TextBlock Style="{StaticResource SidebarCaption}" Text="WORKSPACE"/>
                            <RadioButton Style="{StaticResource NavRadio}"
                                         Command="{Binding TabSettingRebarSectionViewCommand}"
                                         GroupName="menuTab" IsChecked="True"
                                         Content="01   Rebar Layout"
                                         Checked="RadioButton_Checked"/>
                            <RadioButton Style="{StaticResource NavRadio}"
                                         Command="{Binding TabSettingStirrupRebarSectionViewCommand}"
                                         GroupName="menuTab" Content="02   Stirrup System"/>
                            <RadioButton Style="{StaticResource NavRadio}"
                                         Command="{Binding TabSettingBeamViewCommand}"
                                         GroupName="menuTab" Content="03   Beam Rules"/>
                        </StackPanel>

                        <Border Grid.Row="3" Background="#20343D" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="TIP" Foreground="#21C99A" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="Use Copy Current Span to All Spans when the layout is repeated."
                                           Foreground="#B8C8C4" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="#D7E0DD"
                        BorderThickness="1" CornerRadius="8" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <ContentControl Content="{Binding UserControlViewCurrent}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="#D7E0DD" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ready to generate" Foreground="#24414A" FontWeight="SemiBold"/>
                        <TextBlock Text="Review the selected span and copied settings before creating reinforcement."
                                   Foreground="#718A84" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ButtonSecondary}" Command="{Binding CancelCommand}"
                                Margin="0,0,8,0" Content="Cancel"/>
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding OKCommand}"
                                Content="Create Reinforcement"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>


