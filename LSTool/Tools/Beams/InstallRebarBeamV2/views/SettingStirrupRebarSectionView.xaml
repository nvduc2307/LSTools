<UserControl x:Class="LSTool.Tools.Beams.InstallRebarBeamV2.views.SettingStirrupRebarSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LSTool.Tools.Beams.InstallRebarBeamV2.views"
             xmlns:behaviors="clr-namespace:LSTool.Tools.Beams.InstallRebarBeamV2.Support.Wpf"
             xmlns:langs ="clr-namespace:LSTool.Properties.Langs"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        
        <!--<Style TargetType="ComboBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>-->
        <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="4">
                            <Path x:Name="arrow"
                            Data="M 0 0 L 4 4 L 8 0"
                            Stroke="#4A90D9"
                            StrokeThickness="1.5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A90D9"/>
                                <Setter TargetName="border" Property="Background" Value="#F7FBFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A90D9"/>
                                <Setter TargetName="border" Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B8D4EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1A5276"/>
            <Setter Property="Padding" Value="8,0,28,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                    Style="{StaticResource ComboBoxToggleButton}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                Content="{TemplateBinding SelectedItem}"
                                ContentTemplate="{TemplateBinding ItemTemplate}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                             Placement="Bottom"
                             IsOpen="{TemplateBinding IsDropDownOpen}"
                             AllowsTransparency="True"
                             Focusable="False"
                             PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                  Background="White"
                                  BorderBrush="#B8D4EE"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  Margin="0,2,0,0"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#6B8FA8" ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#1A5276"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                          Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EBF4FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6EAF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#C9D8D3"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="#24414A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Label1" TargetType="Label">
            <Setter Property="Foreground" Value="#1A5276"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- Label nhỏ phía trên control -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7C8D"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <!-- Label phân vùng rebar type -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A5276"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,4"/>
        </Style>
        <Style x:Key="ToolbarActionButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="190"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#11A37F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#0D8B6D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D8B6D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#08745A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <behaviors:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>
    <StackPanel Background="#FAFCFB">
        <Border Background="#F1F7F5" BorderBrush="#C9D8D3" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                           Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_SPAN}"
                           Margin="0" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding SettingStirrupSectionViewModel. ElementInstances.RebarBeams}"
                          SelectedItem="{Binding SettingStirrupSectionViewModel. ElementInstances.RebarBeamActive}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SpanDisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="4"
                        Style="{StaticResource ToolbarActionButton}"
                        Command="{Binding CopyCurrentSpanToAllSpansCommand}"
                        Content="Copy Current Span to All Spans"/>
            </Grid>
        </Border>

      <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>

         <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
               <ColumnDefinition/>
               <ColumnDefinition/>
               <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    BorderBrush="#C9D8D3" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,4,0" Background="White">
               <StackPanel Margin="12">
                  <Border Background="#E7F6F1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                     <TextBlock Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_GROUP_SETTING_SECTION_START}"
                                FontWeight="SemiBold" Foreground="#185B4A" FontSize="12"
                                HorizontalAlignment="Center"/>
                  </Border>
                  <Border HorizontalAlignment="Center" Margin="0,0,0,0"
                          BorderBrush="#C9D8D3" BorderThickness="1" CornerRadius="4">
                     <Canvas
                      x:Name="CanvasSectionStart"
                      ClipToBounds="True"
                       Background="#F4F8F6"
                       Height="190"
                       Width="190"/>
                  </Border>
               </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    BorderBrush="#C9D8D3" BorderThickness="1"
                    CornerRadius="6" Margin="4,0,4,0" Background="White">
               <StackPanel Margin="12">
                  <Border Background="#E7F6F1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                     <TextBlock Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_GROUP_SETTING_SECTION_MID}"
                                FontWeight="SemiBold" Foreground="#185B4A" FontSize="12"
                                HorizontalAlignment="Center"/>
                  </Border>
                  <Border HorizontalAlignment="Center" Margin="0,0,0,0"
                          BorderBrush="#C9D8D3" BorderThickness="1" CornerRadius="4">
                     <Canvas
                      x:Name="CanvasSectionMid"
                      ClipToBounds="True"
                       Background="#F4F8F6"
                       Height="190"
                       Width="190"/>
                  </Border>
               </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    BorderBrush="#C9D8D3" BorderThickness="1"
                    CornerRadius="6" Margin="4,0,0,0" Background="White">
               <StackPanel Margin="12">
                  <Border Background="#E7F6F1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                     <TextBlock Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_GROUP_SETTING_SECTION_END}"
                                FontWeight="SemiBold" Foreground="#185B4A" FontSize="12"
                                HorizontalAlignment="Center"/>
                  </Border>
                  <Border HorizontalAlignment="Center" Margin="0,0,0,0"
                          BorderBrush="#C9D8D3" BorderThickness="1" CornerRadius="4">
                     <Canvas
                      x:Name="CanvasSectionEnd"
                      ClipToBounds="True"
                       Background="#F4F8F6"
                       Height="190"
                       Width="190"/>
                  </Border>
               </StackPanel>
            </Border>
         </Grid>

         <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
               <ColumnDefinition/>
               <ColumnDefinition/>
               <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_GROUP_SETTING_REBAR_STIRRUP}" Grid.Column="0" Margin="0,8,4,0">
               <StackPanel>
               <Border>
                  <StackPanel Orientation="Horizontal">
                     <!--<TextBlock Style="{StaticResource SectionLabel}" Margin="0,5,8,4"
           Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_GROUP_SETTING_REBAR_STIRRUP}"/>-->
                     <CheckBox VerticalAlignment="Center"
          Content="Use for All Sections"
          IsChecked="{Binding ElementInstances.IsRebarBeamStirrupSame}"/>
                  </StackPanel>
               </Border>
               <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition/>
                     <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,4,0">
                     <TextBlock Style="{StaticResource FieldLabel}"
           Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_REBAR_DIAMETER}"/>
                     <ComboBox ItemsSource="{Binding ElementInstances.StirrupRebarDiameters}"
          SelectedItem="{Binding ElementInstances.RebarBeamActive.RebarBeamSectionStart.RebarBeamStirrup.Diameter}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4,0,0,0">
                     <TextBlock Style="{StaticResource FieldLabel}"
           Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_REBAR_SPACING}"/>
                     <TextBox behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
         Text="{Binding ElementInstances.RebarBeamActive.RebarBeamSectionStart.RebarBeamStirrup.Spacing, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                  </StackPanel>
               </Grid>
               </StackPanel>
            </GroupBox>
            <GroupBox Header="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_GROUP_SETTING_REBAR_STIRRUP}" Grid.Column="1" Margin="4,8,4,0">
               <StackPanel>
                  <Border>
                     <StackPanel Orientation="Horizontal">
                        <!--<TextBlock Style="{StaticResource SectionLabel}" Margin="0,5,8,4"
  Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_GROUP_SETTING_REBAR_STIRRUP}"/>-->
                        <CheckBox VerticalAlignment="Center"
 Content="Use for All Sections"
 IsChecked="{Binding ElementInstances.IsRebarBeamStirrupSame}"/>
                     </StackPanel>
                  </Border>
                  <Grid Margin="0,0,0,8">
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                     </Grid.ColumnDefinitions>
                     <StackPanel Margin="0,0,4,0">
                        <TextBlock Style="{StaticResource FieldLabel}"
  Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_REBAR_DIAMETER}"/>
                        <ComboBox ItemsSource="{Binding ElementInstances.StirrupRebarDiameters}"
 SelectedItem="{Binding ElementInstances.RebarBeamActive.RebarBeamSectionMid.RebarBeamStirrup.Diameter}"/>
                     </StackPanel>
                     <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}"
  Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_REBAR_SPACING}"/>
                        <TextBox behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
Text="{Binding ElementInstances.RebarBeamActive.RebarBeamSectionMid.RebarBeamStirrup.Spacing, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                     </StackPanel>
                  </Grid>
               </StackPanel>
            </GroupBox>
            <GroupBox Header="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_GROUP_SETTING_REBAR_STIRRUP}" Grid.Column="2" Margin="4,8,0,0">
               <StackPanel>
               <Border>
                  <StackPanel Orientation="Horizontal">
                     <!--<TextBlock Style="{StaticResource SectionLabel}" Margin="0,5,8,4"
  Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_GROUP_SETTING_REBAR_STIRRUP}"/>-->
                     <CheckBox VerticalAlignment="Center"
 Content="Use for All Sections"
 IsChecked="{Binding ElementInstances.IsRebarBeamStirrupSame}"/>
                  </StackPanel>
               </Border>
               <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition/>
                     <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,4,0">
                     <TextBlock Style="{StaticResource FieldLabel}"
  Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_REBAR_DIAMETER}"/>
                     <ComboBox ItemsSource="{Binding ElementInstances.StirrupRebarDiameters}"
 SelectedItem="{Binding ElementInstances.RebarBeamActive.RebarBeamSectionEnd.RebarBeamStirrup.Diameter}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4,0,0,0">
                     <TextBlock Style="{StaticResource FieldLabel}"
  Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_REBAR_SPACING}"/>
                     <TextBox behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
Text="{Binding ElementInstances.RebarBeamActive.RebarBeamSectionEnd.RebarBeamStirrup.Spacing, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                  </StackPanel>
               </Grid>
               </StackPanel>
            </GroupBox>
         </Grid>
         
         <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
               <ColumnDefinition></ColumnDefinition>
               <ColumnDefinition></ColumnDefinition>
               <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
               <RowDefinition></RowDefinition>
               <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <!--Daichinh-->
            <GroupBox Grid.Row="0" Header="Stirrup Shape" Margin="0,8,4,0">
               <StackPanel HorizontalAlignment="Left" Orientation="Vertical">
                  <Grid Height="100">
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                     </Grid.ColumnDefinitions>
                     <RadioButton 
                    Grid.Column="0"
                    DataContext="{Binding ElementInstances}"
                    IsChecked="{Binding RebarBeamActive.MainStirrupType1}"
                    Margin="8">
                        <Image Source="../imgs/stirrupmaintype1.png"/>
                     </RadioButton>
                     <RadioButton 
                    Grid.Column="1"
                    DataContext="{Binding ElementInstances}"
                    IsChecked="{Binding RebarBeamActive.MainStirrupType2}"
                    Margin="8">
                        <Image Source="../imgs/stirrupmaintype2.png"/>
                     </RadioButton>
                     <RadioButton 
                    Grid.Column="2"
                    DataContext="{Binding ElementInstances}"
                    IsChecked="{Binding RebarBeamActive.MainStirrupType3}"
                    Margin="8">
                        <Image Source="../imgs/stirrupmaintype3.png"/>
                     </RadioButton>
                  </Grid>

                  <GroupBox Header="Cap Shape">
                     <Grid>
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition/>
                           <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <RadioButton 
                        Grid.Column="0"
                        DataContext="{Binding ElementInstances}"
                        IsChecked="{Binding RebarBeamActive.MainStirrupTypeHat}"
                        Margin="8">
                           <Image Source="../imgs/135_135.png" Height="25"/>
                        </RadioButton>
                        <RadioButton 
                        DataContext="{Binding ElementInstances}"
                        IsChecked="{Binding RebarBeamActive.MainStirrupTypeHat, Converter={StaticResource InverseBooleanConverter}}"
                        Grid.Column="1"
                        Margin="8">
                           <Image Source="../imgs/90_135.png" Height="25"/>
                        </RadioButton>
                     </Grid>
                  </GroupBox>
               </StackPanel>
            </GroupBox>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,8,4,0">
               <Grid>
                  <Grid.RowDefinitions>
                     <RowDefinition/>
                     <RowDefinition/>
                  </Grid.RowDefinitions>
                  <GroupBox Grid.Row="0" Header="Crosstie Shape">
                     <StackPanel HorizontalAlignment="Left" Orientation="Vertical">
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition/>
                              <ColumnDefinition/>
                           </Grid.ColumnDefinitions>
                           <RadioButton 
                            DataContext="{Binding ElementInstances}"
                            Grid.Column="0"
                            IsChecked="{Binding RebarBeamActive.HorizontalDaiPhu}"
                            Margin="8">
                              <Image Source="../imgs/135_135.png" Height="25"/>
                           </RadioButton>
                           <RadioButton 
                            DataContext="{Binding ElementInstances}"
                            Grid.Column="1"
                            IsChecked="{Binding RebarBeamActive.HorizontalDaiPhu, Converter={StaticResource InverseBooleanConverter}}"
                            Margin="8">
                              <Image Source="../imgs/90_135.png" Height="25"/>
                           </RadioButton>
                        </Grid>
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition/>
                              <ColumnDefinition/>
                           </Grid.ColumnDefinitions>
                           <ComboBox Margin="4"
                            ItemsSource="{Binding ElementInstances.RebarDiameters}"
                            SelectedItem="{Binding SettingStirrupSectionViewModel.RebarDiameterHorizontalDaiPhuChongPhinh}"/>
                           <TextBox 
                           behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                           Grid.Column="1"
                           Margin="4"
                           Text="{Binding SettingStirrupSectionViewModel.SpacingHorizontalDaiPhuChongPhinh}"/>
                        </Grid>
                     </StackPanel>
                  </GroupBox>
                  <GroupBox 
                Margin="0,8,0,0"
                Grid.Row="1" 
                Header="Inner Stirrup Shape (Secondary Stirrup)">
                     <StackPanel HorizontalAlignment="Left" Orientation="Vertical">
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition/>
                              <ColumnDefinition/>
                           </Grid.ColumnDefinitions>
                           <RadioButton 
                            DataContext="{Binding ElementInstances}"
                            Grid.Column="0"
                            IsChecked="{Binding RebarBeamActive.VerticalDaiPhu}"
                            Margin="8">
                              <Image Source="../imgs/135_135.png" Height="25"/>
                           </RadioButton>
                           <RadioButton 
                            DataContext="{Binding ElementInstances}"
                            Grid.Column="1"
                            IsChecked="{Binding RebarBeamActive.VerticalDaiPhu, Converter={StaticResource InverseBooleanConverter}}"
                            Margin="8">
                              <Image Source="../imgs/180_180.png" Height="25"/>
                           </RadioButton>
                        </Grid>
                     </StackPanel>
                  </GroupBox>
               </Grid>
            </StackPanel>
            <!--<GroupBox Grid.Column="2" Header="Opening Settings">
               <StackPanel Margin="12">
                  <StackPanel Orientation="Horizontal">
                     <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Label Content="Reinforcement Pattern" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox 
                        behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                        Grid.Column="1"
                        Margin="4"
                        Width="80"
                        HorizontalAlignment="Center"
                        DataContext="{Binding ElementInstances}"
                        Text="{Binding RebarBeamActive.QuantityStirrupSupportHole, UpdateSourceTrigger=PropertyChanged}"/>
                     </StackPanel>
                  </StackPanel>
               </StackPanel>
            </GroupBox>-->
            <GroupBox Grid.Column="2" Margin="4,8,0,0" Header="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_GROUP_SETTING_DANTORY}">
               <Grid>
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition/>
                     <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,4,0">
                     <TextBlock Style="{StaticResource FieldLabel}"
                HorizontalAlignment="Left" 
                Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_REBAR_DIAMETER}"/>
                     <ComboBox
                ItemsSource="{Binding ElementInstances.RebarDiameters}"
                SelectedItem="{Binding ElementInstances.RebarBeamDantory.Diameter}"/>
                  </StackPanel>
                  <StackPanel Margin="4,0,0,0" Grid.Column="1">
                     <TextBlock Style="{StaticResource FieldLabel}"
                HorizontalAlignment="Left" 
                Text="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_REBAR_QUANTITY}"/>
                     <TextBox Text="{Binding ElementInstances.RebarBeamDantory.Quantity}"/>
                  </StackPanel>
               </Grid>
            </GroupBox>
         </Grid>

      </Grid>
   </StackPanel>
</UserControl>


