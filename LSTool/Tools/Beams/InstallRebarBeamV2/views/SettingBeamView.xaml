<UserControl 
    x:Class="LSTool.Tools.Beams.InstallRebarBeamV2.views.SettingBeamView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:LSTool.Tools.Beams.InstallRebarBeamV2.views"
    xmlns:behaviors="clr-namespace:LSTool.Tools.Beams.InstallRebarBeamV2.Support.Wpf"
    xmlns:langs ="clr-namespace:LSTool.Properties.Langs"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="990">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#C9D8D3"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="#24414A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="4">
                            <Path x:Name="arrow"
                            Data="M 0 0 L 4 4 L 8 0"
                            Stroke="#4A90D9"
                            StrokeThickness="1.5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A90D9"/>
                                <Setter TargetName="border" Property="Background" Value="#F7FBFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A90D9"/>
                                <Setter TargetName="border" Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B8D4EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1A5276"/>
            <Setter Property="Padding" Value="8,0,28,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                    Style="{StaticResource ComboBoxToggleButton}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                Content="{TemplateBinding SelectedItem}"
                                ContentTemplate="{TemplateBinding ItemTemplate}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                             Placement="Bottom"
                             IsOpen="{TemplateBinding IsDropDownOpen}"
                             AllowsTransparency="True"
                             Focusable="False"
                             PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                  Background="White"
                                  BorderBrush="#B8D4EE"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  Margin="0,2,0,0"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#6B8FA8" ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#1A5276"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                          Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EBF4FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6EAF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <StackPanel Background="#FAFCFB">
        <Border Background="#F1F7F5" BorderBrush="#C9D8D3" BorderThickness="1"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Beam Rules" Foreground="#185B4A" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="Define cover, anchorage, stress zones and extension rules for the selected assembly."
                           Foreground="#718A84" FontSize="10" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Margin="0,0,4,0"
                        Header="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_COVER}">
                        <Canvas Height="150">
                            <Image Height="150" Source="../imgs/SettingCover.png"/>
                            <TextBox 
                                Text="{Binding ElementInstances.CoverBeam.TopCover, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                Canvas.Top="10" 
                                Canvas.Left="60" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBox 
                                Text="{Binding ElementInstances.CoverBeam.RightCover, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                Canvas.Top="62" 
                                Canvas.Left="106" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBox 
                                Text="{Binding ElementInstances.CoverBeam.BottomCover, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                Canvas.Top="115" 
                                Canvas.Left="60" 
                                HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <TextBox 
                                Text="{Binding ElementInstances.CoverBeam.LeftCover, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                Canvas.Top="62" 
                                Canvas.Left="14" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Canvas>
                    </GroupBox>
                    <GroupBox Margin="4,0,4,0"
                        Grid.Column="1" 
                        Header="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_SETTING_DISTANCE_R_TO_R}">
                        <Canvas Height="150">
                            <Image Height="150" Source="../imgs/SettingDistanceRToR.png"/>
                            <TextBox 
                                Text="{Binding ElementInstances.DistanceRebarToRebarMm, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                Canvas.Top="63" 
                                Canvas.Left="92" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Canvas>
                    </GroupBox>
                    <GroupBox Header="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_GROUP_SETTING_ANCHOR}" 
                        Grid.ColumnSpan="2" 
                        Grid.Column="2"
                        Margin="4,0,0,0">
                        <StackPanel>
                            <ComboBox 
                            ItemsSource="{Binding ElementInstances.RebarBeamAnchorTypes}"
                            SelectedItem="{Binding ElementInstances.RebarBeamAnchorType}"
                            Width="70"
                            Height="25"
                            Margin="8"
                            HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        <UserControl 
                            Content="{Binding UserControlAnchorBeamTypeViewCurrent}"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </StackPanel>
            <StackPanel Margin="0,8,0,0">
                <GroupBox 
                    Header="{x:Static langs:InstallRebarBeamV2Langs.IRBV2_GROUP_SETTING_BEAM}">
                    <Canvas 
                    Width="885" 
                    Height="245">
                        <Image 
                        Width="885"
                        Source="../imgs/SettingBeam.png"/>
                        <StackPanel Canvas.Top="20"
                                    Canvas.Left="112"
                                    Orientation="Horizontal">
                            <TextBox 
                                Text="{Binding ElementInstances.BeamStressRuleType.StressStart, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="L"/>
                        </StackPanel>
                        <StackPanel Canvas.Top="20"
                            Canvas.Left="357"
                            Orientation="Horizontal">
                            <TextBox 
                                Text="{Binding ElementInstances.BeamStressRuleType.StressMid, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="L"/>
                        </StackPanel>
                        <StackPanel Canvas.Top="20"
                            Canvas.Left="502"
                            Orientation="Horizontal">
                            <TextBox 
                                Text="{Binding ElementInstances.BeamStressRuleType.StressMid, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="L"/>
                        </StackPanel>
                        <StackPanel 
                            Canvas.Top="20"
                            Canvas.Left="746"
                            Orientation="Horizontal">
                            <TextBox 
                                Text="{Binding ElementInstances.BeamStressRuleType.StressEnd, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="L"/>
                        </StackPanel>
                        <StackPanel 
                            Canvas.Top="150"
                            Canvas.Left="125"
                            Orientation="Horizontal">
                            <TextBox 
                                Text="{Binding ElementInstances.RebarExtend.RebarBotExtend, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="d"/>
                        </StackPanel>
                        <StackPanel 
                            Canvas.Top="150"
                            Canvas.Left="335"
                            Orientation="Horizontal">
                            <TextBox 
                                Text="{Binding ElementInstances.RebarExtend.RebarBotExtend, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="d"/>
                        </StackPanel>
                        <StackPanel 
                            Canvas.Top="150"
                            Canvas.Left="514"
                            Orientation="Horizontal">
                            <TextBox 
                                Text="{Binding ElementInstances.RebarExtend.RebarBotExtend, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="d"/>
                        </StackPanel>
                        <StackPanel 
                            Canvas.Top="150"
                            Canvas.Left="727"
                            Orientation="Horizontal">
                            <TextBox 
                                Text="{Binding ElementInstances.RebarExtend.RebarBotExtend, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="d"/>
                        </StackPanel>
                        <StackPanel 
                            Canvas.Top="83"
                            Canvas.Left="170"
                            Orientation="Horizontal">
                            <TextBox 
                                Text="{Binding ElementInstances.RebarExtend.RebarTopExtend, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="d"/>
                        </StackPanel>
                        <StackPanel 
                            Canvas.Top="83"
                            Canvas.Left="290"
                            Orientation="Horizontal">
                            <TextBox 
                                Text="{Binding ElementInstances.RebarExtend.RebarTopExtend, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="d"/>
                        </StackPanel>
                        <StackPanel 
                            Canvas.Top="83"
                            Canvas.Left="562"
                            Orientation="Horizontal">
                            <TextBox 
                                Text="{Binding ElementInstances.RebarExtend.RebarTopExtend, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="d"/>
                        </StackPanel>
                        <StackPanel 
                            Canvas.Top="83"
                            Canvas.Left="680"
                            Orientation="Horizontal">
                            <TextBox 
                                Text="{Binding ElementInstances.RebarExtend.RebarTopExtend, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" 
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="d"/>
                        </StackPanel>
                    </Canvas>
                </GroupBox>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>


