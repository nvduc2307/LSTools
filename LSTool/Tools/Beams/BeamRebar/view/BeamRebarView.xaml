                <ComboBox Width="220" ItemsSource="{Binding BeamRebarModels}" SelectedItem="{Binding BeamRebarModel, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name"/>
            </StackPanel>
        </StackPanel>
