                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Offset: distance from the support outer face to the hook leg. Hook: hook leg length. Top bars hook down, bottom bars hook up. All values in mm." TextWrapping="Wrap" Margin="4,0,4,8"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}" Margin="0,0,6,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}"><TextBlock Text="START" FontWeight="SemiBold"/></Border>
                                <Viewbox Margin="8">
                                    <Grid Width="330" Height="280">
                                        <ContentControl Content="{StaticResource AnchorDrawing}"/>
                                        <Canvas>
                                            <fluent:TextBox Canvas.Left="98" Canvas.Top="8" Width="50" Text="{Binding AnchorStartTopOffset, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Canvas.Left="152" Canvas.Top="13" Text="mm"/>
                                            <fluent:TextBox Canvas.Left="2" Canvas.Top="86" Width="50" Text="{Binding AnchorStartTopHook, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Canvas.Left="16" Canvas.Top="114" Text="mm"/>
                                            <fluent:TextBox Canvas.Left="140" Canvas.Top="242" Width="50" Text="{Binding AnchorStartBotOffset, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Canvas.Left="194" Canvas.Top="247" Text="mm"/>
                                            <fluent:TextBox Canvas.Left="158" Canvas.Top="88" Width="50" Text="{Binding AnchorStartBotHook, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Canvas.Left="212" Canvas.Top="93" Text="mm"/>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="6,0,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}"><TextBlock Text="END" FontWeight="SemiBold"/></Border>
                                <Viewbox Margin="8">
                                    <Grid Width="330" Height="280">
                                        <ContentControl Content="{StaticResource AnchorDrawing}" RenderTransformOrigin="0.5,0.5">
                                            <ContentControl.RenderTransform>
                                                <ScaleTransform ScaleX="-1"/>
                                            </ContentControl.RenderTransform>
                                        </ContentControl>
                                        <Canvas>
                                            <fluent:TextBox Canvas.Left="182" Canvas.Top="8" Width="50" Text="{Binding AnchorEndTopOffset, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Canvas.Left="156" Canvas.Top="13" Text="mm"/>
                                            <fluent:TextBox Canvas.Left="278" Canvas.Top="86" Width="50" Text="{Binding AnchorEndTopHook, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Canvas.Left="292" Canvas.Top="114" Text="mm"/>
                                            <fluent:TextBox Canvas.Left="140" Canvas.Top="242" Width="50" Text="{Binding AnchorEndBotOffset, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Canvas.Left="116" Canvas.Top="247" Text="mm"/>
                                            <fluent:TextBox Canvas.Left="122" Canvas.Top="88" Width="50" Text="{Binding AnchorEndBotHook, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Canvas.Left="96" Canvas.Top="93" Text="mm"/>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Padding="0,8,0,0" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <fluent:Button Content="Vertical tie" Command="{Binding CreateTieVerticalCommand}" Margin="0,0,6,0" ToolTip="Select an inner Top 1 and Bottom 1 bar at the same position."/>
                    <fluent:Button Content="Horizontal tie" Command="{Binding CreateTieHorizontalCommand}" ToolTip="Select outer bars in Top 2/3 or Bottom 2/3."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <fluent:Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource CancelButton}" Margin="0,0,8,0"/>
                    <fluent:Button Content="OK" Command="{Binding OkCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
