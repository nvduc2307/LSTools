<Window x:Class="LSTool.Tools.Beams.BeamRebar.view.BeamRebarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LSTool.Tools.Beams.BeamRebar.view"
        mc:Ignorable="d"
        Title="BeamRebarView" 
        WindowStartupLocation="CenterScreen"
        MinHeight="550" 
        Height="600" 
        Width="800">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="Rebar Info">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Item"/>
                        <ComboBox 
                            Width="100"/>
                    </StackPanel>
                    <Grid 
                        Margin="0,10,0,0"
                        Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <GroupBox 
                            Padding="10"
                            Grid.Column="0"
                            Header="Section Start">
                            <StackPanel>
                                <GroupBox Header="Top 1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Quantity"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Margin="0,10,0,0" Header="Top 2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Quantity"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Margin="0,10,0,0" Header="Stirrup">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Spacing"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Margin="0,10,0,0" Header="Bot 2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Quantity"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Margin="0,10,0,0" Header="Bot 1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Quantity"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox 
                            Padding="10"
                            Grid.Column="1"
                            Header="Section Middle">
                            <StackPanel>
                                <GroupBox Header="Top 1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Quantity"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Margin="0,10,0,0" Header="Top 2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Quantity"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Margin="0,10,0,0" Header="Stirrup">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Spacing"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Margin="0,10,0,0" Header="Bot 2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Quantity"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Margin="0,10,0,0" Header="Bot 1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Quantity"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox 
                            Padding="10"
                            Grid.Column="2"
                            Header="Section End">
                            <StackPanel>
                                <GroupBox Header="Top 1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Quantity"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Margin="0,10,0,0" Header="Top 2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Quantity"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Margin="0,10,0,0" Header="Stirrup">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Spacing"/>
                                            <TextBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Margin="0,10,0,0" Header="Bot 2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Quantity"/>
                                            <TextBox
                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Margin="0,10,0,0" Header="Bot 1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Diameter"/>
                                            <ComboBox
                                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel 
                                            Margin="5,0,0,0" 
                                            Grid.Column="1">
                                            <TextBlock Text="Quantity"/>
                                            <TextBox
                                Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Anchol Info">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel 
                        Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock
                                Text="L1ST"/>
                            <TextBox
                                Text="{Binding L1ST}"/>
                        </StackPanel>
                        <StackPanel Margin="0,5,0,0">
                            <TextBlock
                                Text="L3SB"/>
                            <TextBox
                                Text="{Binding L3SB}"/>
                        </StackPanel>

                        <StackPanel Margin="0,5,0,0">
                            <TextBlock
                                Text="L1ET"/>
                            <TextBox
                                Text="{Binding L1ST}"/>
                        </StackPanel>
                        <StackPanel Margin="0,5,0,0">
                            <TextBlock
                                Text="L3EB"/>
                            <TextBox
                                Text="{Binding L3SB}"/>
                        </StackPanel>
                    </StackPanel>
                    <Image 
                        Grid.Column="1"
                        Source="/LSTool;component/Tools/Beams/BeamRebar/imgs/Setting_Develop.png"/>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel 
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Grid.Row="1">
            <StackPanel Orientation="Horizontal">
                <Button
                    Command="{Binding OkCommand}"
                    Margin="0,0,10,0"
                    Width="70"
                    Height="25"
                    Content="Ok"/>
                <Button
                    Command="{Binding CancelCommand}"
                    Width="70"
                    Height="25"
                    Content="Cancel"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
