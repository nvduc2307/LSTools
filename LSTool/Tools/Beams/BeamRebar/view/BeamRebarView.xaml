                                <TextBlock Grid.Row="8" Text="Bottom 1" Margin="6,0"/>
                                <ComboBox Grid.Row="8" Grid.Column="1" DataContext="{Binding BeamRebarModel.SectionEnd.RebarBot1}" ItemsSource="{Binding Diameters}" SelectedItem="{Binding Name}" MinHeight="24" Height="24" Margin="3,1"/>
                                <fluent:TextBox Grid.Row="8" Grid.Column="2" DataContext="{Binding BeamRebarModel.SectionEnd.RebarBot1}" Text="{Binding Spacing, UpdateSourceTrigger=PropertyChanged, Delay=100}" Style="{StaticResource CellInput}"/>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Border Style="{StaticResource Panel}" Padding="6" Margin="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Section preview" Margin="0,0,0,4"/>
                                    <Canvas Grid.Row="1" x:Name="canvas_end" Background="Transparent" ClipToBounds="True" MinHeight="320"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
            </TabItem>
            <TabItem Header="Anchorage">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}" Margin="0,0,6,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}"><TextBlock Text="ANCHORAGE" FontWeight="SemiBold"/></Border>
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="L1" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <fluent:TextBox Grid.Row="0" Grid.Column="1" Width="70" Margin="0,4,6,4" ToolTip="L1: total anchorage of the top bars" Text="{Binding AnchorStartTopL1, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="x d" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="L3" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <fluent:TextBox Grid.Row="2" Grid.Column="1" Width="70" Margin="0,4,6,4" ToolTip="L3: minimum hook length (top and bottom bars, both ends)" Text="{Binding AnchorStartTopL3, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="x d" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="L2" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <fluent:TextBox Grid.Row="1" Grid.Column="1" Width="70" Margin="0,4,6,4" ToolTip="L2: total anchorage of bottom bars" Text="{Binding AnchorStartBotL2, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="x d" VerticalAlignment="Center"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="6,0,0,0">
                            <Viewbox Margin="8">
                                <ContentControl Content="{StaticResource AnchorDrawing}"/>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Padding="0,8,0,0" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <fluent:Button Content="Vertical tie" Command="{Binding CreateTieVerticalCommand}" Margin="0,0,6,0" ToolTip="Select an inner Top 1 and Bottom 1 bar at the same position."/>
                    <fluent:Button Content="Horizontal tie" Command="{Binding CreateTieHorizontalCommand}" ToolTip="Select outer bars in Top 2/3 or Bottom 2/3."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <fluent:Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource CancelButton}" Margin="0,0,8,0"/>
                    <fluent:Button Content="OK" Command="{Binding OkCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
