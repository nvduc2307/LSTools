<?xml version="1.0" ?>
<Window xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LSTool.Tools.Generals.SettingDiameters.views.RebarDatabasesView" Title="LSTool · Rebar Diameters" Width="820" Height="420" MinWidth="720" MinHeight="340" Style="{DynamicResource ToolWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LSTool;component/Resources/UI/CompactTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"/>
        <Grid Grid.Row="1">
            <fluent:DataGrid ItemsSource="{Binding RebarBarTypes}" SelectionUnit="FullRow" ClipboardCopyMode="ExcludeHeader">
                <fluent:DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" MinWidth="65">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NameStyle, UpdateSourceTrigger=PropertyChanged, Delay=100}" Margin="6,0" TextAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Real Ø (mm)" Width="*" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <fluent:TextBox Text="{Binding BarDiameterReal, UpdateSourceTrigger=PropertyChanged, Delay=100}" Style="{StaticResource CellInput}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Bar Ø (mm)" Width="*" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <fluent:TextBox Text="{Binding BarDiameter, UpdateSourceTrigger=PropertyChanged, Delay=100}" Style="{StaticResource CellInput}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Model Ø (mm)" Width="*" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <fluent:TextBox Text="{Binding ModelBarDiameter, UpdateSourceTrigger=PropertyChanged, Delay=100}" Style="{StaticResource CellInput}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Bend Ø (mm)" Width="*" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <fluent:TextBox Text="{Binding StandardBendDiameter, UpdateSourceTrigger=PropertyChanged, Delay=100}" Style="{StaticResource CellInput}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Hook bend Ø (mm)" Width="*" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <fluent:TextBox Text="{Binding StandardHookBendDiameter, UpdateSourceTrigger=PropertyChanged, Delay=100}" Style="{StaticResource CellInput}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tie bend Ø (mm)" Width="*" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <fluent:TextBox Text="{Binding StirrupOrTieBendDiameter, UpdateSourceTrigger=PropertyChanged, Delay=100}" Style="{StaticResource CellInput}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Max bend R (mm)" Width="*" MinWidth="65">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <fluent:TextBox Text="{Binding MaximumBendRadius, UpdateSourceTrigger=PropertyChanged, Delay=100}" Style="{StaticResource CellInput}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </fluent:DataGrid.Columns>
            </fluent:DataGrid>
        </Grid>
        <Border Grid.Row="2" Padding="0,8,0,0" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <fluent:Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource CancelButton}" Margin="0,0,8,0"/>
                    <fluent:Button Content="OK" Command="{Binding OkCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
