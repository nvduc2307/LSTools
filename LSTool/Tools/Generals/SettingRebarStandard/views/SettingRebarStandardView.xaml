<Window x:Class="LSTool.Tools.Generals.SettingRebarStandard.views.SettingRebarStandardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LSTool.Tools.Generals.SettingRebarStandard.views"
        mc:Ignorable="d"
        Title="SettingRebarStandardView" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        MinHeight="550" 
        SizeToContent="Height"
        Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="General">
                <StackPanel>
                    <GroupBox Header="Setting LapLength">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="L1"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox 
                                        DataContext="{Binding SettingRebarStandardModel}"
                                        Text="{Binding L1}"
                                        Margin="0,5,0,0"
                                        VerticalContentAlignment="Center"
                                        Height="25"/>
                                        <TextBlock 
                                        Grid.Column="1"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="d"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="G"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox 
                                        DataContext="{Binding SettingRebarStandardModel}"
                                        Text="{Binding G}"
                                        Margin="0,5,0,0"
                                        VerticalContentAlignment="Center"
                                        Height="25"/>
                                        <TextBlock 
                                        Grid.Column="1"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="d"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            <Image 
                            Grid.Column="1"
                            Source="/LSTool;component/Tools/Generals/SettingRebarStandard/imgs/LS_Setting_Lap.png"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Setting Anchol">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="L2"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox 
                                        DataContext="{Binding SettingRebarStandardModel}"
                                        Text="{Binding L2}"
                                        Margin="0,5,0,0"
                                        VerticalContentAlignment="Center"
                                        Height="25"/>
                                        <TextBlock 
                                        Grid.Column="1"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="d"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="hMin"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox 
                                    DataContext="{Binding SettingRebarStandardModel}"
                                    Text="{Binding HMin}"
                                    Margin="0,5,0,0"
                                    VerticalContentAlignment="Center"
                                    Height="25"/>
                                        <TextBlock 
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="d"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            <Image 
                            Grid.Column="1"
                            Source="/LSTool;component/Tools/Generals/SettingRebarStandard/imgs/LS_Setting_Anchol.png"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Columns">
                <StackPanel>
                    <GroupBox Header="Setting">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="Cover"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox 
                                            DataContext="{Binding SettingRebarStandardModel}"
                                            Text="{Binding CoverC}"
                                            Margin="0,5,0,0"
                                            VerticalContentAlignment="Center"
                                            Height="25"/>
                                        <TextBlock 
                                            Grid.Column="1"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text=""/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="LC"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox 
                                            DataContext="{Binding SettingRebarStandardModel}"
                                            Text="{Binding LC, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                            Margin="0,5,0,0"
                                            VerticalContentAlignment="Center"
                                            Height="25"/>
                                        <TextBlock 
                                            Grid.Column="1"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text=""/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="E"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox 
                                            DataContext="{Binding SettingRebarStandardModel}"
                                            Text="{Binding EC}"
                                            Margin="0,5,0,0"
                                            VerticalContentAlignment="Center"
                                            Height="25"/>
                                        <TextBlock 
                                            Grid.Column="1"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Mm"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            <Image 
                                Grid.Column="1"
                                Source="/LSTool;component/Tools/Generals/SettingRebarStandard/imgs/LS_Setting_Col_Div.png"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Beams">
                <StackPanel>
                    <GroupBox Header="Setting LapLength">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="E"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox 
                                            DataContext="{Binding SettingRebarStandardModel}"
                                            Text="{Binding EB}"
                                            Margin="0,5,0,0"
                                            VerticalContentAlignment="Center"
                                            Height="25"/>
                                        <TextBlock 
                                            Grid.Column="1"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Mm"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            <Image 
                                Grid.Column="1"
                                Source="/LSTool;component/Tools/Generals/SettingRebarStandard/imgs/LS_Setting_Beam_Div.png"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Grid.Row="1">
            <StackPanel Orientation="Horizontal">
                <Button
                    Command="{Binding OkCommand}"
                    Content="OK"
                    Width="70"
                    Height="25"/>
                <Button
                    Command="{Binding CancelCommand}"
                    Margin="10,0,0,0"
                    Content="Cancel"
                    Width="70"
                    Height="25"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
