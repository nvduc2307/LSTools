<?xml version="1.0" ?>
<Window xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LSTool.Tools.Columns.CreateColumn.view.ColumnRebarView" Title="LSTool · Column Reinforcement" Width="720" Height="400" MinWidth="640" MinHeight="360" Style="{DynamicResource ToolWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LSTool;component/Resources/UI/CompactTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Preset" Margin="0,0,8,0"/>
                    <ComboBox Width="120" ItemsSource="{Binding RebarColumnSettings}" SelectedItem="{Binding RebarColumnSetting}" DisplayMemberPath="Name" Margin="0,0,6,0"/>
                    <fluent:Button Content="Load" Command="{Binding LoadCommand}" Margin="0,0,6,0"/>
                    <fluent:Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,6,0"/>
                    <fluent:Button Content="Remove" Command="{Binding DeleteCommand}"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Name" Margin="8,0,6,0"/>
                    <fluent:TextBox Width="90" Text="{Binding ColumnSettingName}" Margin="0,0,6,0"/>
                    <fluent:Button Content="Save As" Command="{Binding SaveAsCommand}"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Column" Width="48"/>
                <ComboBox Width="220" ItemsSource="{Binding ColumnConcreteModels}" SelectedItem="{Binding ColumnConcreteModel, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Text="Item" Margin="6,0"/>
                        <TextBlock Grid.Column="1" Text="Diameter" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="Qty / Spacing" Margin="6,0"/>
                        <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#E5EAF0" BorderThickness="0,1,0,0"/>
                        <TextBlock Grid.Row="1" Text="Direction X" Margin="6,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" DataContext="{Binding ColumnConcreteModel}" ItemsSource="{Binding DiameterDXs}" SelectedItem="{Binding DiameterDX}" MinHeight="24" Height="24" Margin="3,1"/>
                        <fluent:TextBox Grid.Row="1" Grid.Column="2" DataContext="{Binding ColumnConcreteModel}" Text="{Binding SpacingDX, UpdateSourceTrigger=PropertyChanged, Delay=100}" Style="{StaticResource CellInput}"/>
                        <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="#E5EAF0" BorderThickness="0,1,0,0"/>
                        <TextBlock Grid.Row="2" Text="Direction Y" Margin="6,0"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" DataContext="{Binding ColumnConcreteModel}" ItemsSource="{Binding DiameterDYs}" SelectedItem="{Binding DiameterDY}" MinHeight="24" Height="24" Margin="3,1"/>
                        <fluent:TextBox Grid.Row="2" Grid.Column="2" DataContext="{Binding ColumnConcreteModel}" Text="{Binding SpacingDY, UpdateSourceTrigger=PropertyChanged, Delay=100}" Style="{StaticResource CellInput}"/>
                        <Border Grid.Row="3" Grid.ColumnSpan="3" BorderBrush="#E5EAF0" BorderThickness="0,1,0,0"/>
                        <TextBlock Grid.Row="3" Text="Stirrup mid" Margin="6,0"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" DataContext="{Binding ColumnConcreteModel}" ItemsSource="{Binding DiameterSTs}" SelectedItem="{Binding DiameterST}" MinHeight="24" Height="24" Margin="3,1"/>
                        <fluent:TextBox Grid.Row="3" Grid.Column="2" DataContext="{Binding ColumnConcreteModel}" Text="{Binding SpacingST, UpdateSourceTrigger=PropertyChanged, Delay=100}" Style="{StaticResource CellInput}"/>
                        <Border Grid.Row="4" Grid.ColumnSpan="3" BorderBrush="#E5EAF0" BorderThickness="0,1,0,0"/>
                        <TextBlock Grid.Row="4" Text="Stirrup end" Margin="6,0"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" DataContext="{Binding ColumnConcreteModel}" ItemsSource="{Binding DiameterSTs}" SelectedItem="{Binding DiameterST}" MinHeight="24" Height="24" Margin="3,1"/>
                        <fluent:TextBox Grid.Row="4" Grid.Column="2" DataContext="{Binding ColumnConcreteModel}" Text="{Binding SpacingSTE, UpdateSourceTrigger=PropertyChanged, Delay=100}" Style="{StaticResource CellInput}"/>
                    </Grid>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1">
                <Border Style="{StaticResource Panel}" Padding="6" Margin="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Section preview" Margin="0,0,0,4"/>
                        <Canvas Grid.Row="1" x:Name="CanvasSectionPreView" Background="Transparent" ClipToBounds="True" MinHeight="130"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Padding="0,8,0,0" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <fluent:Button Content="Create tie" Command="{Binding CreateTeiCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <fluent:Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource CancelButton}" Margin="0,0,8,0"/>
                    <fluent:Button Content="OK" Command="{Binding OkCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
