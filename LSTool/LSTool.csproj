<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <LangVersion>latest</LangVersion>
        <PlatformTarget>x64</PlatformTarget>
        <ImplicitUsings>true</ImplicitUsings>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Configurations>Debug R24;Debug R25;Debug R26</Configurations>
        <Configurations>$(Configurations);Release R24;Release R25;Release R26</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Resources\Licenses\WpfUi-*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Revit configuration -->
    <PropertyGroup Condition="$(Configuration.Contains('R24'))">
        <RevitVersion>2024</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>$(DefineConstants);R24</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R25'))">
        <RevitVersion>2025</RevitVersion>
        <TargetFramework>net8.0-windows</TargetFramework>
        <DefineConstants>$(DefineConstants);R25</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R26'))">
        <RevitVersion>2026</RevitVersion>
        <TargetFramework>net8.0-windows</TargetFramework>
        <DefineConstants>$(DefineConstants);R26</DefineConstants>
    </PropertyGroup>

    <!-- Launch configuration -->
    <PropertyGroup>
        <StartAction>Program</StartAction>
        <StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
        <StartArguments>/language ENG</StartArguments>
    </PropertyGroup>

    <!-- Build configuration -->
    <!-- https://github.com/Nice3point/Revit.Build.Tasks -->
    <PropertyGroup>
        <IsRepackable>false</IsRepackable>
        <DeployRevitAddin>true</DeployRevitAddin>
    </PropertyGroup>
    <ItemGroup>
      <None Remove="Resources\Datas\RebarbarTypeData.json" />
      <None Remove="Resources\Datas\RebarBeamSetting.json" />
      <None Remove="Resources\Datas\RebarColumnSetting.json" />
      <None Remove="Resources\Datas\SettingBeam.json" />
      <None Remove="Resources\Datas\SettingColumn.json" />
      <None Remove="Resources\Templates\ShareParameterConcreteBeam.txt" />
      <None Remove="Resources\Templates\ShareParameterConcreteColumn.txt" />
    </ItemGroup>
    <ItemGroup>
      <Content Include="Resources\Datas\RebarbarTypeData.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Datas\DataConcreteCover.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Datas\DataConcreteStrengthRating.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Datas\DataRebarAnchorageHookMainBar.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Datas\DataRebarAnchorageHookStirrup.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Datas\DataRebarAnchorageLength.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Datas\DataRebarLapLength.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Datas\DataRebarLenght.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Datas\RebarBeamSetting.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Datas\RebarColumnSetting.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Datas\SettingBeam.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Datas\SettingColumn.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Settings\ReleaseChannel.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <EmbeddedResource Include="Resources\Settings\ReleaseProfile.dat">
        <LogicalName>LSTool.Resources.Settings.ReleaseProfile.dat</LogicalName>
      </EmbeddedResource>
      <Content Include="Resources\Templates\ShareParameterConcreteBeam.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Templates\ShareParameterConcreteColumn.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- Revit References -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
        <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Build.Tasks" Version="3.0.1" />
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
        <!-- Shared Fluent controls for both net48 and net8.0-windows. -->
        <PackageReference Include="WPF-UI" Version="4.3.0" />
        <!-- MVVM -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
      <Reference Include="System.Net.Http" />
      <Reference Include="System.Windows.Forms" />
      <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" NoWarn="NU1605" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
      <PackageReference Include="MicrosoftOfficeCore" Version="15.0.0" NoWarn="NU1701" />
      <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" NoWarn="NU1605" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
      <PackageReference Include="MicrosoftOfficeCore" Version="15.0.0" NoWarn="NU1701" />
    </ItemGroup>
    
    <ItemGroup>
        <Resource Include="MVVM\imgs\RebarBeamSetting.png" />
        <Resource Include="MVVM\imgs\RebarColumnSetting.png" />
        <Resource Include="Resources\Icons\RibbonIcon16.png" />
        <Resource Include="Resources\Icons\RibbonIcon32.png" />
        <Resource Include="Tools\Beams\InstallRebarBeamV2\imgs\*.png" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Tools\Beams\InstallRebarBeamV2\imgs\*.png" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Resources\RebarShape\**\*.rfa">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Resources\ShareParameters\RTOOL_SHARE_PARAMETER_REBAR_SCHEDULE.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="MVVM\imgs\" />
      <Folder Include="Resources\Imgs\" />
      <Folder Include="Tools\Generals\ManageConcreteCover\viewModel\" />
      <Folder Include="Tools\Generals\ManageConcreteCover\model\" />
      <Folder Include="Tools\Generals\ManageConcreteCover\view\" />
      <Folder Include="Tools\Generals\ManageRebarAnchorageHookMainBar\model\" />
      <Folder Include="Tools\Generals\ManageRebarAnchorageHookMainBar\viewModel\" />
      <Folder Include="Tools\Generals\ManageRebarAnchorageHookMainBar\view\" />
      <Folder Include="Tools\Generals\ManageRebarAnchorageHookStirrup\model\" />
      <Folder Include="Tools\Generals\ManageRebarAnchorageHookStirrup\viewModel\" />
      <Folder Include="Tools\Generals\ManageRebarAnchorageHookStirrup\view\" />
      <Folder Include="Tools\Generals\ManageRebarAnchorageLength\model\" />
      <Folder Include="Tools\Generals\ManageRebarAnchorageLength\viewModel\" />
      <Folder Include="Tools\Generals\ManageRebarAnchorageLength\view\" />
      <Folder Include="Tools\Generals\ManageRebarLapLength\model\" />
      <Folder Include="Tools\Generals\ManageRebarLapLength\viewModel\" />
      <Folder Include="Tools\Generals\ManageRebarLapLength\view\" />
      <Folder Include="Tools\Generals\RebarInfomationParameter\action\" />
      <Folder Include="Tools\Generals\RebarInfomationParameter\model\" />
      <Folder Include="Tools\Generals\RebarInfomationParameter\viewModel\" />
      <Folder Include="Tools\Generals\RebarInfomationParameter\view\" />
      <Folder Include="Tools\Generals\SettingRebarColumn\model\" />
      <Folder Include="Tools\Generals\SettingRebarColumn\viewModel\" />
      <Folder Include="Tools\Generals\SettingRebarColumn\view\" />
    </ItemGroup>
</Project>
